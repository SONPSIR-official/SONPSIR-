# КОМПИЛЯТОР ЯДРА SONPSIR на самом SONPSIR (чистая версия)
пусть re = импорт("re")
пусть лексер = импорт("core.lexer").lexer
пусть кв = chr(34)

пусть токены = []
пусть поз = 0
пусть отступ = 0
пусть рез = "# скомпилировано компилятором SONPSIR-на-SONPSIR"

функция текущий()
    если поз < длина(токены) то
        вернуть токены[поз]
    конец если
    вернуть "КОНЕЦ"
конец функции

функция это(з)
    вернуть текущий() == з
конец функции

функция взять()
    глобально поз
    пусть т = текущий()
    поз = поз + 1
    вернуть т
конец функции

функция ожидать(з)
    глобально поз
    если текущий() != з то
        что печатать("ОШИБКА парсера: ожидал", з, "а получил", текущий())
        выход
    конец если
    поз = поз + 1
конец функции

функция выдать(строка)
    глобально рез, отступ
    рез = рез + перенос + "    " * отступ + строка
конец функции

функция имя_в_питон(имя)
    если имя == "длина" то
        вернуть "len"
    конец если
    если имя == "В_ЧИСЛО" то
        вернуть "int"
    конец если
    если имя == "В_СТРОКУ" то
        вернуть "str"
    конец если
    вернуть имя
конец функции

функция выр()
    вернуть выр_или()
конец функции

функция выр_или()
    пусть л = выр_и()
    пока это("или") делать
        взять()
        л = "(" + л + " or " + выр_и() + ")"
    конец цикла
    вернуть л
конец функции

функция выр_и()
    пусть л = выр_не()
    пока это("и") делать
        взять()
        л = "(" + л + " and " + выр_не() + ")"
    конец цикла
    вернуть л
конец функции

функция выр_не()
    если это("не") то
        взять()
        вернуть "(not " + выр_не() + ")"
    конец если
    вернуть выр_сравнение()
конец функции

функция выр_сравнение()
    пусть л = выр_сложение()
    пока это("==") или это("!=") или это("<") или это(">") или это("<=") или это(">=") делать
        пусть оп = взять()
        л = "(" + л + " " + оп + " " + выр_сложение() + ")"
    конец цикла
    вернуть л
конец функции

функция выр_сложение()
    пусть л = выр_умножение()
    пока это("+") или это("-") делать
        пусть оп = взять()
        л = "(" + л + " " + оп + " " + выр_умножение() + ")"
    конец цикла
    вернуть л
конец функции

функция выр_умножение()
    пусть л = первичное()
    пока это("*") или это("/") или это("%") делать
        пусть оп = взять()
        л = "(" + л + " " + оп + " " + первичное() + ")"
    конец цикла
    вернуть л
конец функции

функция первичное()
    пусть т = текущий()
    если т == "истина" то
        взять()
        вернуть "True"
    конец если
    если т == "ложь" то
        взять()
        вернуть "False"
    конец если
    если т == "ничто" то
        взять()
        вернуть "None"
    конец если
    если т[0] == кв то
        взять()
        вернуть т
    конец если
    если т[0] >= "0" и т[0] <= "9" то
        взять()
        вернуть т
    конец если
    если т == "(" то
        взять()
        пусть вр = выр()
        ожидать(")")
        вернуть "(" + вр + ")"
    конец если
    если re.match("[а-яА-Яa-zA-Z_]", т) то
        взять()
        пусть пит = имя_в_питон(т)
        если это("(") то
            взять()
            пусть а = список_арг()
            ожидать(")")
            вернуть пит + "(" + а + ")"
        конец если
        вернуть пит
    конец если
    что печатать("ОШИБКА: не понял токен", т)
    выход
конец функции

функция список_арг()
    если это(")") то
        вернуть ""
    конец если
    пусть рез2 = выр()
    пока это(",") делать
        взять()
        рез2 = рез2 + ", " + выр()
    конец цикла
    вернуть рез2
конец функции

функция блок_до_иначе()
    пока не это("иначе") и не это("КОНЕЦ_ЕСЛИ") и не это("КОНЕЦ") делать
        заявление()
    конец цикла
конец функции

функция блок_до_конца()
    пока не это("КОНЕЦ_ЕСЛИ") и не это("КОНЕЦ_ЦИКЛА") и не это("КОНЕЦ_ФУНКЦИИ") и не это("КОНЕЦ") делать
        заявление()
    конец цикла
конец функции

функция заявление()
    глобально отступ
    пусть т = текущий()
    если т == "пусть" то
        взять()
        пусть имя = взять()
        ожидать("=")
        выдать(имя + " = " + выр())
        вернуть ""
    конец если
    если т == "ПЕЧАТЬ" то
        взять()
        ожидать("(")
        пусть а = список_арг()
        ожидать(")")
        выдать("print(" + а + ")")
        вернуть ""
    конец если
    если т == "если" то
        взять()
        пусть у = выр()
        ожидать("то")
        выдать("if " + у + ":")
        отступ = отступ + 1
        блок_до_иначе()
        отступ = отступ - 1
        если это("иначе") то
            взять()
            выдать("else:")
            отступ = отступ + 1
            блок_до_конца()
            отступ = отступ - 1
        конец если
        если это("КОНЕЦ_ЕСЛИ") то
            взять()
        конец если
        если это("КОНЕЦ") то
            взять()
        конец если
        вернуть ""
    конец если
    если т == "пока" то
        взять()
        пусть у = выр()
        если это("делать") то
            взять()
        конец если
        выдать("while " + у + ":")
        отступ = отступ + 1
        блок_до_конца()
        отступ = отступ - 1
        если это("КОНЕЦ_ЦИКЛА") то
            взять()
        конец если
        вернуть ""
    конец если
    если т == "повторять" то
        взять()
        пусть н = выр()
        если это("раз") или это("раза") то
            взять()
        конец если
        выдать("for _ in range(" + н + "):")
        отступ = отступ + 1
        блок_до_конца()
        отступ = отступ - 1
        если это("КОНЕЦ_ЦИКЛА") то
            взять()
        конец если
        вернуть ""
    конец если
    если т == "функция" то
        взять()
        пусть имя = взять()
        ожидать("(")
        пусть п = список_арг()
        ожидать(")")
        выдать("def " + имя + "(" + п + "):")
        отступ = отступ + 1
        блок_до_конца()
        отступ = отступ - 1
        если это("КОНЕЦ_ФУНКЦИИ") то
            взять()
        конец если
        вернуть ""
    конец если
    если т == "вернуть" то
        взять()
        выдать("return " + выр())
        вернуть ""
    конец если
    если т == "ПРЕРВАТЬ" то
        взять()
        выдать("break")
        вернуть ""
    конец если
    если т == "ПРОПУСТИТЬ" то
        взять()
        выдать("continue")
        вернуть ""
    конец если
    если т == "выход" то
        взять()
        выдать("raise SystemExit")
        вернуть ""
    конец если
    пусть вр = выр()
    если это("=") то
        взять()
        выдать(вр + " = " + выр())
    иначе
        выдать(вр)
    конец если
    вернуть ""
конец функции

пусть цель = аргументы[1]
пусть код = прочитать файл(цель)
пусть код2 = лексер.нормализовать(код)
пусть ш = кв + "[^" + кв + "]*" + кв + "|[0-9]+|[а-яА-Яa-zA-Z_][а-яА-Яa-zA-Z_0-9]*|==|!=|<=|>=|[+*/()<>!=,-]"
пусть токены = re.findall(ш, код2)

пока не это("КОНЕЦ") делать
    заявление()
конец цикла

записать в файл("_out2.py", рез)
что печатать("Компилятор SONPSIR-на-SONPSIR собрал", цель, "-> _out2.py")
что печатать("--- вывод ---")
что печатать(система("python3 _out2.py"))
