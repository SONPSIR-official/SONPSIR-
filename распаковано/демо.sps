что печатать(привет)
пусть имя = "гость"
что печатать(имя)

пусть х = 7
если х > 5 то
    что печатать("х большой")
иначе
    что печатать("х маленький")
конец если

повторять 3 раза
    что печатать("ура")
конец цикла

функция квадрат(н)
    вернуть н * н
конец функции
что печатать("квадрат 5 =", квадрат(5))

