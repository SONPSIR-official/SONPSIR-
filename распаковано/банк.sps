# Настоящая программа: банковские счета (ООП)

класс Счёт
    метод создать(владелец, баланс)
        само.владелец = владелец
        само.баланс = баланс
    конец метода
    метод пополнить(сумма)
        само.баланс = само.баланс + сумма
        что печатать("Пополнено на", сумма)
    конец метода
    метод снять(сумма)
        если сумма > само.баланс то
            что печатать("Не хватает денег!")
        иначе
            само.баланс = само.баланс - сумма
            что печатать("Снято", сумма)
        конец если
    конец метода
    метод отчёт()
        что печатать("владелец:", само.владелец, "баланс:", само.баланс)
    конец метода
конец класса

пусть мой = Счёт("Артур", 100)
мой.пополнить(50)
мой.снять(200)
мой.снять(30)
мой.отчёт()

пусть текст = "Привет, Мир"
что печатать(текст.вверх())
что печатать(текст.вниз())

пусть список = [1, 2, 3]
если 2 в список то
    что печатать("двойка есть")
конец если

пусть число = в число("42")
что печатать(число + 1)
