визуал заголовок("Анимация героя")
визуал тема("тёмная")
визуал html_рус("
заголовок2 Герой идёт и машет
блок id='box3d'
")
визуал html("<script src='three.min.js'></script>")
визуал скрипт_рус("
пусть мир = сцена_создать('box3d')
пусть герой = группа()
пусть голова = меш_сфера('#ffdbac')
размер(голова, 0.6, 0.6, 0.6)
позиция(голова, 0, 1.5, 0)
добавить_в(герой, голова)
пусть волосы = меш_сфера('whitesmoke')
размер(волосы, 0.68, 0.62, 0.68)
позиция(волосы, 0, 1.62, -0.08)
добавить_в(герой, волосы)
пусть тело = меш_куб('gray')
размер(тело, 0.5, 0.7, 0.3)
позиция(тело, 0, 0.8, 0)
добавить_в(герой, тело)
пусть таз = меш_куб('dimgray')
размер(таз, 0.45, 0.2, 0.28)
позиция(таз, 0, 0.35, 0)
добавить_в(герой, таз)
пусть нога1 = меш_цилиндр('dimgray')
размер(нога1, 0.22, 0.8, 0.22)
позиция(нога1, -0.15, -0.1, 0)
добавить_в(герой, нога1)
пусть нога2 = меш_цилиндр('dimgray')
размер(нога2, 0.22, 0.8, 0.22)
позиция(нога2, 0.15, -0.1, 0)
добавить_в(герой, нога2)
пусть рука1 = меш_цилиндр('gray')
размер(рука1, 0.16, 0.7, 0.16)
позиция(рука1, -0.4, 0.8, 0)
добавить_в(герой, рука1)
пусть рука2 = меш_цилиндр('gray')
размер(рука2, 0.16, 0.7, 0.16)
позиция(рука2, 0.4, 0.8, 0)
добавить_в(герой, рука2)
добавить_в(мир, герой)
пусть время = 0
функция тик()
    время = время + 0.06
    поворот_y(герой, 0.01)
    рука1.rotation.x = синус(время) * 0.8
    рука2.rotation.x = синус(время + 3.14) * 0.8
    нога1.rotation.x = синус(время + 3.14) * 0.6
    нога2.rotation.x = синус(время) * 0.6
    герой.position.y = косинус(время * 2) * 0.05
    отрисовать(мир)
    кадр(тик)
конец функции
тик()
")
визуал показать()
