# SONPSIR — новые возможности

# 1. Списки
пусть покупки = ["хлеб", "молоко"]
добавить в покупки("сыр")
что печатать(покупки)
что печатать(длина списка(покупки))
что печатать(покупки[0])

# 2. Математика
что печатать(округлить(17.6))
что печатать(остаток от деления(10, 3))
пусть удача = случайное число от 1 до 10
что печатать("случайное число:", удача)

# 3. Текст
что печатать(длина текста("Артур"))
пусть части = разделить текст("привет,мир,сон", ",")
что печатать(части)

# 4. Управление циклом (пропустит 3, остановится на 5)
повторять i от 1 до 5
    если i == 3 то
        пропустить круг
    конец если
    если i == 5 то
        прервать цикл
    конец если
    что печатать(i)
конец цикла

# 5. Файлы
записать в файл("лог.txt", "Привет от SONPSIR!")
пусть из_файла = прочитать файл("лог.txt")
что печатать("из файла:", из_файла)

