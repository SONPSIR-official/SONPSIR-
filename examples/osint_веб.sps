# OSINT-дашборд с красивым визуалом
пусть последний = ""
функция построить()
    визуал очистить
    визуал текст("Введи IP — узнаю страну и город")
    визуал поле("запрос", "IP-адрес")
    если последний != "" то
        визуал текст(последний)
    конец если
конец функции
функция событие(имя, данные)
    глобально последний
    если "запрос" в ключи(данные) то
        попробуй
            пусть инфо = инфо ип(данные["запрос"])
            последний = данные["запрос"] + " → " + значение(инфо, "country", "?") + ", " + значение(инфо, "city", "?")
        перехватить ошибку
            последний = "Не удалось узнать IP"
        конец попытки
    конец если
    построить()
конец функции
визуал заголовок("SONPSIR OSINT")
построить()
визуал показать(8081, событие)
