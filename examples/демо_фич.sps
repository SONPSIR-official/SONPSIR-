# Новые клёвые фичи
что печатать("сейчас:", сейчас время)
что печатать("дата:", сегодня дата)
что печатать("пи =", пи)

пусть числа = [3, 1, 2]
что печатать("отсортировано:", отсортировать(числа))
что печатать("перевёрнуто:", перевернуть(числа))
что печатать("случайный:", случайный_элемент(числа))

что печатать("файлы:", список_файлов("examples"))
что печатать("демо есть?", файл_существует("examples/демо.sps"))
что печатать(система("echo привет из системы"))

функция тик()
    что печатать("тик", сейчас время)
конец функции
каждые(1, тик)
ждать(3)
что печатать("готово")
