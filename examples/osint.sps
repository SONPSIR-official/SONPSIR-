# OSINT-инструменты
пусть страница = забрать страницу("http://example.com")
что печатать("ссылки:", извлечь ссылки(страница))

попробуй
    пусть инфо = инфо ип("8.8.8.8")
    что печатать("IP 8.8.8.8:", значение(инфо, "country"), ",", значение(инфо, "city"))
перехватить ошибку
    что печатать("IP-сервис недоступен")
конец попытки

пусть коор = координаты("Москва")
если длина(коор) > 0 то
    что печатать("Москва:", коор[0]["lat"], коор[0]["lon"])
конец если
что печатать("погода:", погода("Москва"))

# Универсальность: ЛЮБОЙ модуль Python
пусть math = импорт("math")
что печатать("sqrt(16) =", math.sqrt(16))
