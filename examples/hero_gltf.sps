визуал заголовок("Герой из GLTF")
визуал тема("тёмная")
визуал html_рус("
заголовок2 Настоящая скелетная анимация
блок id='box3d'
")
визуал html("<script src='three.min.js'></script><script src='GLTFLoader.js'></script>")
визуал скрипт("
function загрузить_героя(файл, колбэк){new THREE.GLTFLoader().load(файл, колбэк);}
function играть_анимации(г){var m=new THREE.AnimationMixer(г.scene);for(var i=0;i<г.animations.length;i++){m.clipAction(г.animations[i]).play();}return m;}
")
визуал скрипт_рус("
пусть мир = сцена_создать('box3d')
пусть миксер = 0
пусть прошлое = 0
функция поставить(г)
    добавить_в(мир, г.scene)
    миксер = играть_анимации(г)
конец функции
загрузить_героя('CesiumMan.glb', поставить)
функция тик()
    пусть сейчас = Date.now() / 1000
    если миксер != 0 то
        миксер.update(сейчас - прошлое)
    конец если
    прошлое = сейчас
    отрисовать(мир)
    кадр(тик)
конец функции
тик()
")
визуал показать()
