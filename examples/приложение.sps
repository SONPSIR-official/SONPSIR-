# Красивое интерактивное приложение
пусть нажатий = 0

функция построить()
    визуал очистить
    визуал текст("Нажатий: " + в строку(нажатий))
    визуал кнопка("👆 Нажми", "плюс")
    визуал кнопка("Сброс", "сброс")
    визуал поле("имя_юзера", "Твоё имя")
конец функции

функция событие(имя, данные)
    глобально нажатий
    если имя == "плюс" то
        нажатий = нажатий + 1
    конец если
    если имя == "сброс" то
        нажатий = 0
    конец если
    если "имя_юзера" в ключи(данные) то
        визуал заголовок("Привет, " + данные["имя_юзера"] + "!")
    конец если
    построить()
конец функции

визуал заголовок("SONPSIR Визуал")
построить()
визуал показать(8080, событие)
